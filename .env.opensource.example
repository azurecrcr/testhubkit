# Test Hub Kit 开源部署环境变量示例
# 复制为 .env 后按需修改：cp .env.opensource.example .env

# =============================================================================
# 必填：数据库
# =============================================================================
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PASSWORD=changeme
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=testhub
MYSQL_DATABASE=testhub

# =============================================================================
# 必填：Flask 会话密钥（生产环境务必改为随机长字符串）
# =============================================================================
FLASK_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# =============================================================================
# 必填：MinIO 对象存储（头像、附件、媒体文件）
# =============================================================================
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=changeme-minio
OPENIM_MINIO_ENDPOINT=minio:9000
OPENIM_MINIO_ACCESS_KEY=root
OPENIM_MINIO_SECRET_KEY=changeme-minio
OPENIM_MINIO_BUCKET=openim
OPENIM_MINIO_USE_SSL=false
OPENIM_MINIO_PUBLIC_ENDPOINT=localhost:10005

# =============================================================================
# AI 模型（OpenAI 兼容接口）—— 不配则 AI 功能不可用，其余工具正常
# =============================================================================
BUILTIN_AI_BASE_URL=https://api.openai.com/v1
BUILTIN_AI_API_KEY=sk-your-key-here
BUILTIN_AI_MODEL=gpt-4o-mini
BUILTIN_AI_TEMPERATURE=0.1
BUILTIN_AI_IMAGE_MODEL=dall-e-3

# 视觉模型（可与文本模型相同）
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=gpt-4o

# RAG 知识召回（可选，默认关闭）
RAG_ENABLED=0
RAG_EMBED_MODEL=text-embedding-v3
RAG_EMBED_API_KEY=
RAG_EMBED_BASE_URL=

# =============================================================================
# 认证与通知（开源默认：邮箱注册，短信关闭）
# =============================================================================
SMS_AUTH_ENABLED=false
EMAIL_REGISTER_DISABLED=false
PHONE_BIND_GATE_ENABLED=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 反馈邮件通知（可选）
FEEDBACK_EMAIL_ENABLED=false
FEEDBACK_NOTIFY_EMAIL=admin@example.com
FEEDBACK_SMTP_HOST=smtp.example.com
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USE_SSL=true
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_FROM=
FEEDBACK_SMTP_PASSWORD=

# =============================================================================
# 站点行为
# =============================================================================
TZ=Asia/Shanghai
TEMPLATES_AUTO_RELOAD=false
CONTEXT_STACK_ENABLED=1
ADMIN_RAG_NO_PASSWORD=0

# 敏感功能统一上锁（1=需密码解锁，0=全部开放）
# 首次启动 mysql-init.sql 默认 is_locked=0

# =============================================================================
# 对外访问地址（用于生成分享链接等，按实际域名填写）
# =============================================================================
# PUBLIC_BASE_URL=http://your-domain.com
